<Window x:Class="ValheimWorldSync.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Valheim World Sync" Width="660" Height="740" MinWidth="600" MinHeight="620"
    WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource CanvasBrush}">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="VALHEIM / WORLD SYNC" FontSize="12" FontWeight="SemiBold" Foreground="#A5C98E"/>
                <TextBlock Text="Um mundo. Sua próxima aventura." FontSize="25" FontWeight="SemiBold" Margin="0,10,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="O progresso acompanha quem vai hospedar a partida." Foreground="{StaticResource MutedBrush}" FontSize="14"/>
            </StackPanel>
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#344C3C" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,25,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding WorldLabel}" Foreground="#A5C98E" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding StatusTitle}" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,8" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="14" LineHeight="22" MinHeight="66"/>
                    <ProgressBar Height="5" Margin="0,14,0,0" IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressPercent}" Foreground="#A5C98E" Background="#344C3C" BorderThickness="0"/>
                    <TextBlock Text="{Binding TransferDetails}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Button Grid.Row="2" Content="Jogar" Command="{Binding PlayCommand}" FontSize="19" FontWeight="SemiBold" Padding="18,14" Background="#B5D69E" Foreground="#142119" BorderBrush="#B5D69E"/>
            <TextBlock Grid.Row="3" Text="O app prepara o save e abre o Valheim. Escolha seu personagem e o mundo dentro do jogo." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,20"/>
            <StackPanel Grid.Row="4">
                <UniformGrid Columns="3" Margin="-4,0">
                    <Button Content="Configuração" Command="{Binding ConfigureCommand}" Margin="4"/>
                    <Button Content="Recarregar" Command="{Binding ReloadCommand}" Margin="4"/>
                    <Button Content="Amigos na Steam" Command="{Binding FriendsCommand}" Margin="4"/>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="-4,4">
                    <Button Content="Importar mundo local" Command="{Binding ImportCommand}" Margin="4"/>
                    <Button Content="Tentar sincronizar" Command="{Binding RetryCommand}" Margin="4"/>
                    <Button Content="Exportar progresso" Command="{Binding ExportCommand}" Margin="4"/>
                    <Button Content="Voltar à nuvem…" Command="{Binding UseCloudCommand}" Margin="4"/>
                    <Button Content="Reinicializar remoto…" Command="{Binding ResetCommand}" Margin="4"/>
                </UniformGrid>
            </StackPanel>
            <Grid Grid.Row="5" Margin="0,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Fechar esta janela mantém o app na bandeja." Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Recuperação ↗" Command="{Binding RecoveryCommand}" Padding="8,5" FontSize="12" Background="Transparent" BorderBrush="Transparent"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
