<Window x:Class="ValheimWorldSync.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:ValheimWorldSync.Core.Models;assembly=ValheimWorldSync.Core" xmlns:loc="clr-namespace:ValheimWorldSync.Desktop.Localization"
 Title="Valheim World Sync" Width="820" Height="540" MinWidth="760" MinHeight="460" Icon="vws.ico" WindowStartupLocation="CenterScreen" Background="{StaticResource Background.Base}" Foreground="{StaticResource Text.Primary}" FontFamily="{StaticResource Font.Interface}" FontSize="13">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,24">
     <TextBlock Text="{loc:Loc Main_HeroKicker}"/>
     <TextBlock Text="{loc:Loc Main_HeroTitle}" Style="{StaticResource HeroTextStyle}" Margin="0,12,0,4"/>
     <TextBlock Text="{loc:Loc Main_HeroSubtitle}" Foreground="{StaticResource Text.Muted}"/>
    </StackPanel>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
    <StackPanel>
      <ComboBox ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding ActiveProfile}" DisplayMemberPath="Local.Alias" AutomationProperties.Name="{loc:Loc Main_ActiveProfile}" Margin="0,0,0,12"/>
     <Border Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Hairline}" BorderThickness="1" CornerRadius="4">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border CornerRadius="4,0,0,4"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource Status.Warning}"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding State}" Value="{x:Static models:SyncState.Idle}"><Setter Property="Background" Value="{StaticResource Status.Positive}"/></DataTrigger>
         <DataTrigger Binding="{Binding State}" Value="{x:Static models:SyncState.Playing}"><Setter Property="Background" Value="{StaticResource Status.Positive}"/></DataTrigger>
         <DataTrigger Binding="{Binding State}" Value="{x:Static models:SyncState.Conflict}"><Setter Property="Background" Value="{StaticResource Destructive.Base}"/></DataTrigger>
         <DataTrigger Binding="{Binding State}" Value="{x:Static models:SyncState.Error}"><Setter Property="Background" Value="{StaticResource Destructive.Base}"/></DataTrigger>
        </Style.Triggers></Style></Border.Style></Border>
       <StackPanel Grid.Column="1" Margin="16">
        <TextBlock Text="{Binding WorldLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorldLabel}"/>
        <TextBlock Text="{Binding StatusTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,8" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource Text.Muted}"/>
        <ProgressBar Height="4" Margin="0,12,0,0" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{StaticResource Accent.Bronze}" Background="{StaticResource Border.Hairline}" BorderThickness="0"/>
        <TextBlock Text="{Binding TransferDetails}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
       </StackPanel>
      </Grid>
     </Border>
      <Button Content="{loc:Loc Main_Play}" Command="{Binding PlayCommand}" Style="{StaticResource PrimaryButtonStyle}" FontSize="18" Margin="0,16,0,0"/>
      <TextBlock Text="{loc:Loc Main_PlayHint}" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
     <TextBlock Text="{Binding CloudGuidance}" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
      <TextBlock Text="{loc:Loc Main_SectionSession}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"/>
      <WrapPanel><Button Content="{loc:Loc Main_Friends}" Command="{Binding FriendsCommand}" Margin="0,0,12,0"/><Button Content="{loc:Loc Main_Reload}" Command="{Binding ReloadCommand}"/></WrapPanel>
      <TextBlock Text="{loc:Loc Main_SectionWorld}" Style="{StaticResource CaptionTextStyle}" Margin="0,24,0,8"/>
      <WrapPanel><Button Content="{loc:Loc Main_Import}" Command="{Binding ImportCommand}" Margin="0,0,12,12"/><Button Content="{loc:Loc Main_Export}" Command="{Binding ExportCommand}" Margin="0,0,0,12"/><Button Content="{loc:Loc Main_Retry}" Command="{Binding RetryCommand}" Margin="0,0,12,0"/><Button Content="{loc:Loc Main_UseCloud}" Command="{Binding UseCloudCommand}" Style="{StaticResource CloudButtonStyle}"/></WrapPanel>
      <TextBlock Text="{loc:Loc Main_SectionAdvanced}" Style="{StaticResource CaptionTextStyle}" Margin="0,24,0,8"/>
      <WrapPanel><Button Content="{loc:Loc Main_Configure}" Command="{Binding ConfigureCommand}" Margin="0,0,12,12"/><Button Content="{loc:Loc Main_Reset}" Command="{Binding ResetCommand}" Style="{StaticResource DestructiveButtonStyle}" Margin="0,0,0,12"/></WrapPanel>
    </StackPanel>
   </Grid>
   <DockPanel Grid.Row="2" Margin="0,24,0,0">
     <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"><Hyperlink Command="{Binding RecoveryCommand}" Foreground="{StaticResource Text.Muted}"><Run Text="{loc:Loc Main_RecoveryLink}"/></Hyperlink></TextBlock>
     <TextBlock Text="{loc:Loc Main_TrayHint}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
   </DockPanel>
  </Grid>
 </ScrollViewer>
</Window>
