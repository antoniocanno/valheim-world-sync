<Window x:Class="ValheimWorldSync.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ValheimWorldSync.Desktop.Localization" Title="{loc:Loc Settings_Title}" Width="760" Height="820" MinWidth="700" MinHeight="480" WindowStartupLocation="CenterOwner" Icon="vws.ico" Background="{StaticResource Background.Base}" Foreground="{StaticResource Text.Primary}" FontFamily="{StaticResource Font.Interface}" FontSize="13">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24">
   <TextBlock Text="{loc:Loc Settings_Hero}" Style="{StaticResource HeroTextStyle}"/><TextBlock Text="{loc:Loc Settings_HeroSubtitle}" Foreground="{StaticResource Text.Muted}" Margin="0,4,0,24"/>
   <TextBlock Text="{loc:Loc Settings_SectionPlayer}" Style="{StaticResource SectionTextStyle}"/><Border BorderBrush="{StaticResource Border.Hairline}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Label Content="{loc:Loc Settings_PlayerName}" Target="{Binding ElementName=PlayerBox}" Foreground="{StaticResource Text.Primary}"/><TextBox Grid.Column="1" x:Name="PlayerBox" Margin="0,0,0,12"/>
    <Label Grid.Row="1" Content="{loc:Loc Settings_Profile}" Target="{Binding ElementName=ProfilesBox}" Foreground="{StaticResource Text.Primary}"/>
    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{loc:Loc Settings_New}" Click="NewClicked" Margin="12,0,0,0"/><Button Content="{loc:Loc Settings_ImportInvite}" Click="ImportInviteClicked" Margin="12,0,0,0"/></StackPanel><ComboBox x:Name="ProfilesBox" DisplayMemberPath="Local.Alias" SelectionChanged="ProfileChanged"/></DockPanel>
    <Label Grid.Row="2" Content="{loc:Loc Settings_Alias}" Target="{Binding ElementName=AliasBox}" Foreground="{StaticResource Text.Primary}"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="AliasBox" Margin="0,0,0,12"/>
    <Label Grid.Row="3" Content="{loc:Loc Settings_Language}" Target="{Binding ElementName=LanguageBox}" Foreground="{StaticResource Text.Primary}"/><ComboBox Grid.Row="3" Grid.Column="1" x:Name="LanguageBox" DisplayMemberPath="Label"/>
   </Grid>
   <TextBlock Text="{loc:Loc Settings_SectionConnection}" Style="{StaticResource SectionTextStyle}" Margin="0,24,0,8"/><Border BorderBrush="{StaticResource Border.Hairline}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Label Content="{loc:Loc Settings_Endpoint}" Target="{Binding ElementName=EndpointBox}" Foreground="{StaticResource Text.Primary}"/><TextBox Grid.Column="1" x:Name="EndpointBox" Margin="0,0,0,12"/>
    <Label Grid.Row="1" Content="{loc:Loc Settings_Bucket}" Target="{Binding ElementName=BucketBox}" Foreground="{StaticResource Text.Primary}"/>
    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><TextBox x:Name="BucketBox"/><Label Grid.Column="1" Content="{loc:Loc Settings_Retention}" Target="{Binding ElementName=RetentionBox}" Foreground="{StaticResource Text.Primary}" Margin="16,0,8,0"/><TextBox Grid.Column="2" x:Name="RetentionBox"/></Grid>
    <Label Grid.Row="2" Content="{loc:Loc Settings_AccessKey}" Target="{Binding ElementName=AccessBox}" Foreground="{StaticResource Text.Primary}"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="AccessBox" FontFamily="{StaticResource Font.Technical}" Margin="0,0,0,12"/>
    <Label Grid.Row="3" Content="{loc:Loc Settings_SecretKey}" Target="{Binding ElementName=SecretBox}" Foreground="{StaticResource Text.Primary}"/>
    <Grid Grid.Row="3" Grid.Column="1"><PasswordBox x:Name="SecretBox" PasswordChanged="SecretChanged"/><TextBlock x:Name="SecretPlaceholder" Text="{loc:Loc Settings_SecretPlaceholder}" FontStyle="Italic" Foreground="{StaticResource Text.Muted}" Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
    <Button Grid.Row="4" Grid.Column="1" Content="{loc:Loc Settings_Test}" Click="TestClicked" HorizontalAlignment="Right" Margin="0,12,0,0"/>
  </Grid>
   <TextBlock Text="{loc:Loc Settings_SectionWorld}" Style="{StaticResource SectionTextStyle}" Margin="0,24,0,8"/><Border BorderBrush="{StaticResource Border.Hairline}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Label Content="{loc:Loc Settings_WorldId}" Target="{Binding ElementName=WorldIdBox}" Foreground="{StaticResource Text.Primary}"/><TextBox Grid.Column="1" x:Name="WorldIdBox" FontFamily="{StaticResource Font.Technical}" Margin="0,0,0,12"/>
    <Label Grid.Row="1" Content="{loc:Loc Settings_DisplayName}" Target="{Binding ElementName=DisplayBox}" Foreground="{StaticResource Text.Primary}"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="DisplayBox" Margin="0,0,0,12"/>
    <Label Grid.Row="2" Content="{loc:Loc Settings_WorldFolder}" Target="{Binding ElementName=FolderBox}" Foreground="{StaticResource Text.Primary}"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="FolderBox"/>
    <Button Grid.Row="3" Grid.Column="1" Content="{loc:Loc Settings_DetectWorld}" Click="ChooseWorldClicked" HorizontalAlignment="Right" Margin="0,12,0,0"/>
  </Grid>
   <TextBlock Text="{loc:Loc Settings_SectionSaves}" Style="{StaticResource SectionTextStyle}" Margin="0,24,0,8"/><Border BorderBrush="{StaticResource Border.Hairline}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>
   <DockPanel><Button Content="{loc:Loc Settings_ChooseSaves}" Click="ChooseSavesRootClicked" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox x:Name="SavesBox" AutomationProperties.Name="{loc:Loc Settings_SectionSaves}"/></DockPanel>
  <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="{StaticResource Text.Muted}" Margin="0,12,0,12" AutomationProperties.LiveSetting="Polite"/>
  <Border BorderBrush="{StaticResource Border.Hairline}" BorderThickness="0,0,0,1" Margin="0,0,0,16"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition MinWidth="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="{loc:Loc Settings_DeleteProfile}" Click="DeleteClicked" Style="{StaticResource DestructiveButtonStyle}"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="{loc:Loc Settings_ExportInvite}" Click="ExportInviteClicked"/><Button Content="{loc:Loc Settings_Save}" Click="SaveClicked" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0"/></StackPanel></Grid>
 </StackPanel></ScrollViewer>
</Window>
