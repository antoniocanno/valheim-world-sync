<Window x:Class="ValheimWorldSync.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configuração — Valheim World Sync" Width="700" Height="760" WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
 <ScrollViewer><StackPanel Margin="28">
  <TextBlock Text="CONFIGURAÇÃO" Foreground="#A5C98E" FontWeight="SemiBold"/><TextBlock Text="Jogador e mundos compartilhados" FontSize="24" Margin="0,8,0,18"/>
  <TextBlock Text="Nome do jogador"/><TextBox x:Name="PlayerBox" Margin="0,5,0,14"/>
  <DockPanel><ComboBox x:Name="ProfilesBox" DisplayMemberPath="Local.Alias" SelectionChanged="ProfileChanged" MinWidth="350"/><Button Content="Novo" Click="NewClicked" Margin="8,0,0,0"/><Button Content="Importar convite" Click="ImportInviteClicked" Margin="8,0,0,0"/></DockPanel>
  <TextBlock Text="Endpoint R2" Margin="0,16,0,0"/><TextBox x:Name="EndpointBox" Margin="0,5,0,10"/>
  <UniformGrid Columns="2"><StackPanel Margin="0,0,5,0"><TextBlock Text="Bucket"/><TextBox x:Name="BucketBox"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="Retenção"/><TextBox x:Name="RetentionBox"/></StackPanel></UniformGrid>
  <UniformGrid Columns="2" Margin="0,10,0,0"><StackPanel Margin="0,0,5,0"><TextBlock Text="Access Key ID"/><TextBox x:Name="AccessBox"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="Secret Access Key (vazio mantém atual)"/><PasswordBox x:Name="SecretBox"/></StackPanel></UniformGrid>
  <UniformGrid Columns="2" Margin="0,10,0,0"><StackPanel Margin="0,0,5,0"><TextBlock Text="Nome do perfil"/><TextBox x:Name="AliasBox"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="ID do mundo"/><TextBox x:Name="WorldIdBox"/></StackPanel></UniformGrid>
  <UniformGrid Columns="2" Margin="0,10,0,0"><StackPanel Margin="0,0,5,0"><TextBlock Text="Nome exibido"/><TextBox x:Name="DisplayBox"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="Pasta do mundo"/><TextBox x:Name="FolderBox"/></StackPanel></UniformGrid>
  <Button Content="Detectar a partir de um mundo local…" Click="ChooseWorldClicked" HorizontalAlignment="Left" Margin="0,9,0,0"/>
  <TextBlock Text="Pasta de saves (avançado; vazio usa detecção automática)" Margin="0,10,0,0"/><TextBox x:Name="SavesBox"/>
  <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,14"/>
  <DockPanel><StackPanel Orientation="Horizontal"><Button Content="Excluir perfil" Click="DeleteClicked"/><Button Content="Exportar convite" Click="ExportInviteClicked" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Testar R2" Click="TestClicked"/><Button Content="Salvar e ativar" Click="SaveClicked" Margin="8,0,0,0"/></StackPanel></DockPanel>
 </StackPanel></ScrollViewer>
</Window>
