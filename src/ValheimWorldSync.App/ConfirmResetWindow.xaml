<Window x:Class="ValheimWorldSync.Desktop.ConfirmResetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reinicializar mundo remoto" Width="500" Height="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
 <StackPanel Margin="28"><TextBlock Text="Substituir o mundo remoto" FontSize="22"/><TextBlock x:Name="Instruction" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,15"/><CheckBox x:Name="BackupCheck" Content="Entendo que uma nova versão será publicada"/><TextBox x:Name="NameBox" Margin="0,12,0,8"/><TextBlock x:Name="ErrorText" Foreground="#E69B8F"/><Button Content="Reinicializar" Click="ConfirmClicked" HorizontalAlignment="Right" Margin="0,14,0,0"/></StackPanel>
</Window>
