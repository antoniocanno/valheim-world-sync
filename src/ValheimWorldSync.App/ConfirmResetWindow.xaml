<Window x:Class="ValheimWorldSync.Desktop.ConfirmResetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ValheimWorldSync.Desktop.Localization" Title="{loc:Loc Reset_Title}" Width="500" Height="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Icon="vws.ico" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
  <StackPanel Margin="28"><TextBlock Text="{loc:Loc Reset_Heading}" FontSize="22"/><TextBlock x:Name="Instruction" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,15"/><CheckBox x:Name="BackupCheck" Content="{loc:Loc Reset_Acknowledge}"/><TextBox x:Name="NameBox" Margin="0,12,0,8"/><TextBlock x:Name="ErrorText" Foreground="#E69B8F"/><Button Content="{loc:Loc Reset_Confirm}" Click="ConfirmClicked" HorizontalAlignment="Right" Margin="0,14,0,0"/></StackPanel>
</Window>
