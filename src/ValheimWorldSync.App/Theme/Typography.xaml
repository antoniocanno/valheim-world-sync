<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <FontFamily x:Key="Font.Interface">Segoe UI</FontFamily><FontFamily x:Key="Font.Hero">Segoe UI Semibold</FontFamily><FontFamily x:Key="Font.Technical">Consolas</FontFamily>
 <Style x:Key="HeroTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Font.Hero}"/><Setter Property="FontSize" Value="24"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="SectionTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
 <Style x:Key="CaptionTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource Text.Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
</ResourceDictionary>
