<Window x:Class="ValheimWorldSync.Desktop.RecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Recuperação — Valheim World Sync" Width="820" Height="520" WindowStartupLocation="CenterOwner" Icon="vws.ico" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
 <Grid Margin="25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Cópias verificadas deste perfil" FontSize="23"/>
  <DataGrid Grid.Row="1" x:Name="EntriesGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,18,0,12" SelectionMode="Single"><DataGrid.Columns>
   <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt}" Width="180"/><DataGridTextColumn Header="Jogador" Binding="{Binding Player}" Width="140"/><DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="100"/><DataGridTextColumn Header="Origem" Binding="{Binding Origin}" Width="*"/>
  </DataGrid.Columns></DataGrid>
  <TextBlock Grid.Row="2" x:Name="ResultText" Foreground="{StaticResource MutedBrush}"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Guardar cópia…" Click="ExportClicked"/><Button Content="Restaurar neste computador" Click="RestoreClicked" Margin="8,0,0,0"/><Button Content="Excluir" Click="DeleteClicked" Margin="8,0,0,0"/></StackPanel>
 </Grid>
</Window>
