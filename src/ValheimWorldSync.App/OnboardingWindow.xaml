<Window x:Class="ValheimWorldSync.Desktop.OnboardingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ValheimWorldSync.Desktop.Localization" Title="{loc:Loc Onboarding_Title}" Width="600" Height="410" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Icon="vws.ico" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
  <StackPanel Margin="36"><TextBlock Text="{loc:Loc Onboarding_Kicker}" Foreground="#A5C98E"/><TextBlock Text="{loc:Loc Onboarding_Heading}" FontSize="27" Margin="0,10,0,8"/><TextBlock Text="{loc:Loc Onboarding_Body}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
   <TextBlock Text="{loc:Loc Settings_PlayerName}" Margin="0,25,0,5"/><TextBox x:Name="PlayerBox"/>
   <UniformGrid Columns="2" Margin="0,28,0,0"><Button Content="{loc:Loc Onboarding_Create}" Click="CreateClicked" Margin="0,0,6,0" Padding="10"/><Button Content="{loc:Loc Onboarding_Join}" Click="JoinClicked" Margin="6,0,0,0" Padding="10"/></UniformGrid>
  <TextBlock x:Name="ErrorText" Foreground="#E69B8F" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </StackPanel>
</Window>
