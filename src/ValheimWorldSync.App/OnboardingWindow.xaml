<Window x:Class="ValheimWorldSync.Desktop.OnboardingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Bem-vindo — Valheim World Sync" Width="600" Height="410" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
 <StackPanel Margin="36"><TextBlock Text="VALHEIM / WORLD SYNC" Foreground="#A5C98E"/><TextBlock Text="Prepare sua primeira aventura" FontSize="27" Margin="0,10,0,8"/><TextBlock Text="Seu nome fica somente neste computador. Depois, crie um mundo compartilhado ou entre com um convite." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
  <TextBlock Text="Nome do jogador" Margin="0,25,0,5"/><TextBox x:Name="PlayerBox"/>
  <UniformGrid Columns="2" Margin="0,28,0,0"><Button Content="Criar mundo compartilhado" Click="CreateClicked" Margin="0,0,6,0" Padding="10"/><Button Content="Entrar com convite" Click="JoinClicked" Margin="6,0,0,0" Padding="10"/></UniformGrid>
  <TextBlock x:Name="ErrorText" Foreground="#E69B8F" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </StackPanel>
</Window>
