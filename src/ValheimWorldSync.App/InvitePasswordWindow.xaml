<Window x:Class="ValheimWorldSync.Desktop.InvitePasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ValheimWorldSync.Desktop.Localization" Title="{loc:Loc Invite_Title}" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Icon="vws.ico" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
     <StackPanel Margin="24,20,24,24">
         <TextBlock Text="{loc:Loc Invite_Title}" FontSize="20" FontWeight="SemiBold"/>
         <TextBlock Text="{loc:Loc Invite_Hint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
         <PasswordBox x:Name="PasswordBox" Padding="6,4"/>
         <TextBlock x:Name="ErrorText" Foreground="#E69B8F" Margin="0,6,0,8" TextWrapping="Wrap" MinHeight="18"/>
         <Button Content="{loc:Loc Invite_Continue}" Click="ContinueClicked" HorizontalAlignment="Right" MinWidth="110"/>
    </StackPanel>
</Window>
