<Window x:Class="ValheimWorldSync.Desktop.InvitePasswordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Senha do convite" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Icon="vws.ico" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="24,20,24,24">
        <TextBlock Text="Senha do convite" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Use pelo menos 3 caracteres e envie a senha separadamente do arquivo." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
        <PasswordBox x:Name="PasswordBox" Padding="6,4"/>
        <TextBlock x:Name="ErrorText" Foreground="#E69B8F" Margin="0,6,0,8" TextWrapping="Wrap" MinHeight="18"/>
        <Button Content="Continuar" Click="ContinueClicked" HorizontalAlignment="Right" MinWidth="110"/>
    </StackPanel>
</Window>
